# ─── App ─────────────────────────────────────────────────────────────────────
VITE_APP_NAME=CA Management
VITE_APP_VERSION=1.0.0

# ─── API ─────────────────────────────────────────────────────────────────────
# Base URL for all API calls (Vite proxy keeps this as a relative path in dev)
VITE_API_URL=/api/v1

# Full backend server URL — used by the Vite dev-server proxy
# Change this to your deployed backend URL in production
VITE_API_BASE_URL=http://localhost:5000

# ─── Dev Server ──────────────────────────────────────────────────────────────
# Port the Vite dev server listens on (default: 5173)
VITE_PORT=5173

# ─── Features ────────────────────────────────────────────────────────────────
VITE_DEBUG=false
